{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "constraints": {
    "erlang": "^27"
  },
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "main",
    "release"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "security"
    ],
    "automerge": true
  },
  "separateMinorPatch": true,
  "packageRules": [
    {
      "description": "Disable regular updates on release by default and split minor/patch versions",
      "matchBaseBranches": [
        "release"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Re-enable patch updates on release",
      "matchBaseBranches": [
        "release"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": true,
      "automerge": true
    }
  ]
}
