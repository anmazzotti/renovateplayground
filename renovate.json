{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "constraints": {
    "erlang": "^27"
  },
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main", "release"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Disable standard updates on release (security alerts still bypass this)",
      "matchBaseBranches": ["release"],
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "description": "Allow patch updates on release",
      "matchBaseBranches": ["release"],
      "matchUpdateTypes": ["patch"],
      "enabled": true
    }
  ]
}
