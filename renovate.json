{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "constraints": {
    "erlang": "^27"
  },
  "extends": [
    "config:recommended"
  ],
  "baseBranches": ["main", "release"],
  "packageRules": [
    {
      "matchBaseBranches": ["release"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchBaseBranches": ["release"],
      "matchUpdateTypes": ["patch"],
      "enabled": true
    }
  ]
}
